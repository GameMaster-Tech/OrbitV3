# ==============================================================================
# ORBIT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your credentials.
# Never commit .env.local or any actual API keys to source control.

# ------------------------------------------------------------------------------
# Firebase Realtime Database & Authentication (Client-side exposed)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# AI Provider Keys (Server-side ONLY - Never expose with NEXT_PUBLIC_)
# ------------------------------------------------------------------------------
# Groq API Key (powers GPT-OSS 120B for household assistant & expiry prediction)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (powers Gemini 3.5 Flash for recipe generation & vision fallbacks)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-3.5-flash
GEMINI_PRO_MODEL=gemini-3.5-flash

# Google Cloud Vision API Key (for optical label/barcode/text recognition)
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here
